{
	"name": "@harperfast/agent-memory",
	"version": "0.1.0",
	"description": "Shared, permissioned, live memory for agents and people — a Harper plugin",
	"license": "Apache-2.0",
	"author": {
		"name": "HarperDB, Inc.",
		"email": "opensource@harperdb.io",
		"url": "https://harper.fast/"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/HarperFast/agent-memory.git"
	},
	"bugs": {
		"url": "https://github.com/HarperFast/agent-memory/issues"
	},
	"homepage": "https://github.com/HarperFast/agent-memory#readme",
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": "./dist/index.js",
		"./config": "./config.yaml"
	},
	"files": [
		"dist/",
		"!dist/**/*.map",
		"schema/",
		"config.yaml",
		"README.md",
		"DESIGN.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"prepack": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc --sourceMap false",
		"test": "npm run build && node --import ./test/helpers/harper-mock.mjs --test \"test/**/*.test.js\"",
		"install:fixtures": "node scripts/install-fixtures.js",
		"test:integration": "harper-integration-test-run \"integrationTests/**/*.test.ts\"",
		"format:check": "prettier --check .",
		"format:write": "prettier --write ."
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.135.0",
		"@harperfast/integration-testing": "1.0.5",
		"@types/node": "^22.0.0",
		"harper": "^5.3.1",
		"prettier": "^3.6.2",
		"typescript": "^5.8.0"
	},
	"peerDependencies": {
		"harper": ">=5.3.1"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	}
}
